    assert.eq r138 true;
    get.or_use credits.aleo/delegated[r0[7u32]] 0u64 into r139;
    ternary r128 r139 0u64 into r140;
    add r125 r140 into r141;
    ternary r132 r139 0u64 into r142;
    add r127 r142 into r143;
    // Slot 8.
    lt 8u32 r1 into r144;
    not r144 into r145;
    shr r2 8u32 into r146;
    and r146 1u128 into r147;
    is.eq r147 1u128 into r148;
    and r148 r145 into r149;
    assert.eq r149 false;
    contains credits.aleo/committee[r0[8u32]] into r150;
    or r150 r145 into r151;
    assert.eq r151 true;
    cast r0[8u32] into r152 as field;
    lt r136 r152 into r153;
    or r153 r145 into r154;
    assert.eq r154 true;
    get.or_use credits.aleo/delegated[r0[8u32]] 0u64 into r155;
    ternary r144 r155 0u64 into r156;
    add r141 r156 into r157;
    ternary r148 r155 0u64 into r158;
    add r143 r158 into r159;
    // Slot 9.
    lt 9u32 r1 into r160;
    not r160 into r161;
    shr r2 9u32 into r162;
    and r162 1u128 into r163;
    is.eq r163 1u128 into r164;
    and r164 r161 into r165;
    assert.eq r165 false;
    contains credits.aleo/committee[r0[9u32]] into r166;
    or r166 r161 into r167;
    assert.eq r167 true;
    cast r0[9u32] into r168 as field;
    lt r152 r168 into r169;
    or r169 r161 into r170;
    assert.eq r170 true;
    get.or_use credits.aleo/delegated[r0[9u32]] 0u64 into r171;
    ternary r160 r171 0u64 into r172;
    add r157 r172 into r173;
    ternary r164 r171 0u64 into r174;
    add r159 r174 into r175;
    // Slot 10.
    lt 10u32 r1 into r176;
    not r176 into r177;
    shr r2 10u32 into r178;
    and r178 1u128 into r179;
    is.eq r179 1u128 into r180;
    and r180 r177 into r181;
    assert.eq r181 false;
    contains credits.aleo/committee[r0[10u32]] into r182;
    or r182 r177 into r183;
    assert.eq r183 true;
    cast r0[10u32] into r184 as field;
    lt r168 r184 into r185;
    or r185 r177 into r186;
    assert.eq r186 true;
    get.or_use credits.aleo/delegated[r0[10u32]] 0u64 into r187;
    ternary r176 r187 0u64 into r188;
    add r173 r188 into r189;
    ternary r180 r187 0u64 into r190;
    add r175 r190 into r191;
    // Slot 11.
    lt 11u32 r1 into r192;
    not r192 into r193;
    shr r2 11u32 into r194;
    and r194 1u128 into r195;
    is.eq r195 1u128 into r196;
    and r196 r193 into r197;
    assert.eq r197 false;
    contains credits.aleo/committee[r0[11u32]] into r198;
    or r198 r193 into r199;
    assert.eq r199 true;
    cast r0[11u32] into r200 as field;
    lt r184 r200 into r201;
    or r201 r193 into r202;
    assert.eq r202 true;
    get.or_use credits.aleo/delegated[r0[11u32]] 0u64 into r203;
    ternary r192 r203 0u64 into r204;
    add r189 r204 into r205;
    ternary r196 r203 0u64 into r206;
    add r191 r206 into r207;
    // Slot 12.
    lt 12u32 r1 into r208;
    not r208 into r209;
    shr r2 12u32 into r210;
    and r210 1u128 into r211;
    is.eq r211 1u128 into r212;
    and r212 r209 into r213;
    assert.eq r213 false;
    contains credits.aleo/committee[r0[12u32]] into r214;
    or r214 r209 into r215;
    assert.eq r215 true;
    cast r0[12u32] into r216 as field;
    lt r200 r216 into r217;
    or r217 r209 into r218;
    assert.eq r218 true;
    get.or_use credits.aleo/delegated[r0[12u32]] 0u64 into r219;
    ternary r208 r219 0u64 into r220;
