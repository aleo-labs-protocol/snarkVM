finalize submit_votes:
    input r0 as [address; 128u32].public;
    input r1 as u32.public;
    input r2 as u128.public;
    input r3 as freeze_vote.public;
    // 1. Check the vote: this network, not expired, the current nonce, and a valid action.
    is.eq r3.network network.id into r4;
    assert.eq r4 true;
    lt block.height r3.expires into r5;
    assert.eq r5 true;
    get.or_use nonce[0u8] 0u64 into r6;
    assert.eq r3.nonce r6;
    // A freeze has FREEZE_DELAY < duration <= MAX_FREEZE_BLOCKS; a thaw has duration 0.
    is.eq r3.action 1u8 into r7;
    gt r3.duration 60u32 into r8;
    lte r3.duration 201600u32 into r9;
    and r8 r9 into r10;
    and r7 r10 into r11;
    is.eq r3.action 2u8 into r12;
    is.eq r3.duration 0u32 into r13;
    and r12 r13 into r14;
    or r11 r14 into r15;
    assert.eq r15 true;

    // 2. Check that the list is the whole committee.
    // 2.1. The count equals the committee size, and fits in the list.
    get credits.aleo/metadata[aleo1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq3ljyzc] into r16;
    assert.eq r16 r1;
    lte r1 128u32 into r17;
    assert.eq r17 true;

    // 2.2, 2.3 and 3. For each active slot: the member is in the committee, the list is
    // strictly increasing by field cast, and its stake counts toward the total, and toward
    // the signed stake if its mask bit is set. An inactive slot (i >= count) must have its
    // mask bit clear, and is otherwise ignored.
    // Slot 0.
    lt 0u32 r1 into r18;
    not r18 into r19;
    shr r2 0u32 into r20;
    and r20 1u128 into r21;
    is.eq r21 1u128 into r22;
    and r22 r19 into r23;
    assert.eq r23 false;
    contains credits.aleo/committee[r0[0u32]] into r24;
    or r24 r19 into r25;
    assert.eq r25 true;
    cast r0[0u32] into r26 as field;
    get.or_use credits.aleo/delegated[r0[0u32]] 0u64 into r27;
    ternary r18 r27 0u64 into r28;
    add 0u64 r28 into r29;
    ternary r22 r27 0u64 into r30;
    add 0u64 r30 into r31;
    // Slot 1.
    lt 1u32 r1 into r32;
    not r32 into r33;
    shr r2 1u32 into r34;
    and r34 1u128 into r35;
    is.eq r35 1u128 into r36;
    and r36 r33 into r37;
    assert.eq r37 false;
    contains credits.aleo/committee[r0[1u32]] into r38;
    or r38 r33 into r39;
    assert.eq r39 true;
    cast r0[1u32] into r40 as field;
    lt r26 r40 into r41;
    or r41 r33 into r42;
    assert.eq r42 true;
    get.or_use credits.aleo/delegated[r0[1u32]] 0u64 into r43;
    ternary r32 r43 0u64 into r44;
    add r29 r44 into r45;
    ternary r36 r43 0u64 into r46;
    add r31 r46 into r47;
    // Slot 2.
    lt 2u32 r1 into r48;
    not r48 into r49;
    shr r2 2u32 into r50;
    and r50 1u128 into r51;
    is.eq r51 1u128 into r52;
    and r52 r49 into r53;
    assert.eq r53 false;
    contains credits.aleo/committee[r0[2u32]] into r54;
    or r54 r49 into r55;
    assert.eq r55 true;
    cast r0[2u32] into r56 as field;
    lt r40 r56 into r57;
    or r57 r49 into r58;
    assert.eq r58 true;
    get.or_use credits.aleo/delegated[r0[2u32]] 0u64 into r59;
    ternary r48 r59 0u64 into r60;
    add r45 r60 into r61;
    ternary r52 r59 0u64 into r62;
    add r47 r62 into r63;
    // Slot 3.
    lt 3u32 r1 into r64;
    not r64 into r65;
    shr r2 3u32 into r66;
    and r66 1u128 into r67;
    is.eq r67 1u128 into r68;
    and r68 r65 into r69;
    assert.eq r69 false;
    contains credits.aleo/committee[r0[3u32]] into r70;
    or r70 r65 into r71;
    assert.eq r71 true;
    cast r0[3u32] into r72 as field;
    lt r56 r72 into r73;
    or r73 r65 into r74;
    assert.eq r74 true;
    get.or_use credits.aleo/delegated[r0[3u32]] 0u64 into r75;
    ternary r64 r75 0u64 into r76;
    add r61 r76 into r77;
    ternary r68 r75 0u64 into r78;
    add r63 r78 into r79;
    // Slot 4.
    lt 4u32 r1 into r80;
    not r80 into r81;
    shr r2 4u32 into r82;
    and r82 1u128 into r83;
    is.eq r83 1u128 into r84;
    and r84 r81 into r85;
    assert.eq r85 false;
    contains credits.aleo/committee[r0[4u32]] into r86;
    or r86 r81 into r87;
    assert.eq r87 true;
    cast r0[4u32] into r88 as field;
    lt r72 r88 into r89;
    or r89 r81 into r90;
    assert.eq r90 true;
    get.or_use credits.aleo/delegated[r0[4u32]] 0u64 into r91;
    ternary r80 r91 0u64 into r92;
    add r77 r92 into r93;
    ternary r84 r91 0u64 into r94;
    add r79 r94 into r95;
    // Slot 5.
    lt 5u32 r1 into r96;
